@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dataCatalogX: <https://w3id.org/dataCatalogX#> .

########################################
# DATA CATALOG REPRESENTATIVE
########################################

dataCatalogX:DataCatalogRepresentative a owl:Class .

dataCatalogX:organization a owl:DatatypeProperty ; rdfs:domain dataCatalogX:DataCatalogRepresentative ; rdfs:range xsd:string .
dataCatalogX:organizationName a owl:DatatypeProperty ; rdfs:domain dataCatalogX:DataCatalogRepresentative ; rdfs:range xsd:string .
dataCatalogX:name a owl:DatatypeProperty ; rdfs:domain dataCatalogX:DataCatalogRepresentative ; rdfs:range xsd:string .
